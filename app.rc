1 ICON "assets/icon.ico"

// Explorer -> Properties -> Details. VER_* come from Cargo.toml via build.rs.
1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Zaryab Mustafa"
      VALUE "FileDescription", "Headroom"
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "headroom"
      VALUE "LegalCopyright", "Copyright (c) 2026 Zaryab Mustafa. Based on claude-usage-widget by Abdulrahman Sarmini. MIT License."
      VALUE "OriginalFilename", "headroom.exe"
      VALUE "ProductName", "Headroom"
      VALUE "ProductVersion", VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
